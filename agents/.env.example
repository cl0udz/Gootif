# Copy to .env and fill in. The wrapper (run.sh) sources this for cron.

# Needed so headless `claude` finds your subscription login at ~/.claude
HOME=/home/youruser
PATH=/usr/local/bin:/usr/bin:/bin

# Path to the Claude Code CLI (run `which claude` to find it)
CLAUDE_BIN=/usr/local/bin/claude

# Gootif API
GOOTIF_URL=https://gootif.jianwei.me
# Service key from server/API.md (X-Service-Key)
GOOTIF_SERVICE_KEY=YOUR_SERVICE_KEY
