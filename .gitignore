# macOS
.DS_Store

# Xcode — project is generated by `xcodegen generate`
Gootif.xcodeproj/
DerivedData/
build/
*.xcuserstate

# Secrets — never commit real keys
server/config.php
server/agents/.env
server/agents/google-mcp.json
Gootif/Services/Secrets.swift

# Server runtime data (keep the deny-all .htaccess tracked)
server/data/*
!server/data/.htaccess

# Python
__pycache__/
*.pyc

# Claude Code local settings
.claude/settings.local.json
