[Unit]
Description=Gootif Apple push delivery worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
Environment=GOOTIF_CONFIG=/etc/gootif/gootif.env
ExecStart=/usr/local/bin/gootif push-worker
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# /var/lib/gootif — DB_PATH in gootif.env must live here.
StateDirectory=gootif
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
