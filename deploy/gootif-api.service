[Unit]
Description=Gootif notification API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
Environment=GOOTIF_CONFIG=/etc/gootif/gootif.env
ExecStart=/usr/local/bin/gootif serve --listen 127.0.0.1:18090
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# /var/lib/gootif — DB_PATH in gootif.env must live here.
StateDirectory=gootif
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
