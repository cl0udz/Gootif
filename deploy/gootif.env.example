# Copy to /etc/gootif/gootif.env (root:www-data, mode 640) and fill in real values.
# Format: KEY=VALUE per line, value taken verbatim (no quotes, no shell expansion).
# Generate keys with:  openssl rand -hex 24

# Write key for services/agents (X-Service-Key on POST /api/notifications)
SERVICE_KEY=REPLACE_WITH_YOUR_SERVICE_KEY
# Read/delete key for the client apps (X-API-Key)
APP_KEY=REPLACE_WITH_YOUR_APP_KEY
# SQLite database (WAL mode). Keep it outside any webroot.
DB_PATH=/var/lib/gootif/gootif.db

# APNs push (optional). With APNS_ENABLED=0 notifications are stored but not pushed,
# and POST /api/devices answers 503.
APNS_ENABLED=0
APNS_TEAM_ID=
APNS_IOS_TOPIC=com.goosheys.gootif
APNS_MACOS_TOPIC=com.goosheys.gootif-mac
APNS_SANDBOX_KEY_ID=
APNS_SANDBOX_KEY_PATH=/etc/gootif/AuthKey_sandbox.p8
APNS_PRODUCTION_KEY_ID=
APNS_PRODUCTION_KEY_PATH=/etc/gootif/AuthKey_production.p8
